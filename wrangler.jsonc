/**
 * Wrangler configuration for Codex Proxy API
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-proxy-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-30",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Smart Placement (optional)
  // "placement": { "mode": "smart" },

  /**
   * -------------------------------------------------------------------
   * Production Resource Bindings
   * -------------------------------------------------------------------
   */

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2d718af1fa914b91b351cf448da32137"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-proxy",
      "database_id": "dd7c65a3-c0ea-4cff-9f76-c40eeadea9fe",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "codex-proxy"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "codex-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "codex-tasks",
        "script_name": "codex-proxy-api",
        "queue_id": "419c6b4432284df19edd9c460187cb69"
      }
    ]
  },

  "workflows": [
    {
      "binding": "WORKFLOW",
      "workflow_name": "codex-proxy"
    }
  ],

  /**
   * -------------------------------------------------------------------
   * Static Assets
   * -------------------------------------------------------------------
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  /**
   * -------------------------------------------------------------------
   * Environment Variables
   * -------------------------------------------------------------------
   */
  "vars": {
    "ENV": "production",
    "LOG_LEVEL": "info"
  },

  /**
   * -------------------------------------------------------------------
   * Durable Objects and Containers
   * -------------------------------------------------------------------
   */
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },

  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ]
}
